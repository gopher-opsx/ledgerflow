# Normalize text files across Windows/macOS/Linux.
* text=auto

# Shell and automation files must stay LF-only.
*.sh text eol=lf
Makefile text eol=lf

# Source and configuration files.
*.go text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary/archive formats should never be line-ending normalized.
*.zip binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.p12 binary
*.jks binary
*.keystore binary
*.truststore binary
