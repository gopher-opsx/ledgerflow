FROM golang:1.23-alpine AS build

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/transaction-api ./cmd/transaction-api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/transaction-api /transaction-api
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/transaction-api"]
